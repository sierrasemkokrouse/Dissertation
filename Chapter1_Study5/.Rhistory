scale_fill_grey() +
theme(legend.position="none") +
annotate("text", x = 1.5, y = 1.8, label = "*", size = 8, color = "lightblue") +
annotate("segment", x = 1, xend = 2, y = 1.7, yend = 1.7, size = 1, color = "lightblue")
