labs(x = "Noncompliance Incident / 'Strike'",
y = "Perceived Patient Honesty",
fill = "Patient SES") +
theme_perez() +
scale_fill_grey() +
theme(legend.position="none") +
annotate("text", x = 2, y = 4.3, label = "***",
size = 8, color = "lightblue") +
annotate("segment", x = 1.8, xend = 2.2, y = 4.2, yend = 4.2,
size = 1, color = "lightblue")
